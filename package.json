    "install:backend": "npm install --prefix fixora-backend",
    "install:frontend": "npm install --prefix fixora-frontend",
    "install:all": "npm run install:backend",
    "start:backend": "npm run start --prefix fixora-backend",
    "start:backend:dev": "npm run dev --prefix fixora-backend",
    "start:frontend": "npm start --prefix fixora-frontend",
    "dev": "concurrently \"npm run start:backend:dev\" \"npm run start:frontend\"",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "test:backend": "npm test --prefix fixora-backend"
  },
